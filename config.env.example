# COPY THIS FILE TO backend/config.env AND FILL IN YOUR VALUES
# DO NOT COMMIT config.env TO GITHUB!

# ===========================================
# MongoDB Configuration
# ===========================================
# Get this from MongoDB Atlas:
# 1. Go to mongodb.com/cloud/atlas
# 2. Create a cluster (free tier available)
# 3. Database Access → Add Database User
# 4. Network Access → Add IP (0.0.0.0/0 for all)
# 5. Connect → Connect your application → Copy connection string
MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/fasalguard?retryWrites=true&w=majority

# ===========================================
# JWT Secret Key
# ===========================================
# Use a strong random string (minimum 32 characters)
# Generate one: https://randomkeygen.com/
JWT_SECRET=your_super_secret_jwt_key_change_this_to_random_string_minimum_32_characters

# ===========================================
# Email Configuration (Gmail)
# ===========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587

# Your Gmail address
EMAIL_USER=your-email@gmail.com

# App-specific password (NOT your regular Gmail password!)
# How to get it:
# 1. Go to: https://myaccount.google.com/apppasswords
# 2. Select "Mail" and "Other (Custom name)"
# 3. Name it "FasalGuard"
# 4. Copy the 16-character password
EMAIL_PASS=your-16-character-app-password-here

# ===========================================
# OpenWeather API
# ===========================================
# Get free API key:
# 1. Go to: https://openweathermap.org/api
# 2. Sign up for free account
# 3. API keys → Create key
# 4. Copy the key (may take 10 minutes to activate)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ===========================================
# Server Configuration
# ===========================================
PORT=5000
NODE_ENV=development

# Frontend URL (change if using different port)
FRONTEND_URL=http://localhost:3000

# ===========================================
# NOTES FOR COLLABORATORS
# ===========================================
# - Ask project owner for production credentials
# - For development, you can use your own MongoDB/email
# - Never commit this file to Git (it's in .gitignore)
# - Copy this template as: backend/config.env
